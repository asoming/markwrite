{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markwrite",
  "version": "0.1.0",
  "identifier": "app.markwrite.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "墨页 · Markwrite", "width": 1360, "height": 900, "minWidth": 760, "minHeight": 560, "backgroundColor": "#FCFCFD" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown editor",
    "fileAssociations": [{ "ext": ["md", "markdown"], "mimeType": "text/markdown", "description": "Markdown document", "role": "Editor" }]
  }
}
